# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_chars

# Database Configuration (PostgreSQL / AWS RDS)
# Option A: Full Connection URL
DATABASE_URL=postgres://afadmin:your_db_password@your-rds-endpoint.amazonaws.com:5432/apparelflow?sslmode=require

# Option B: Individual Parameters (Used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=apparelflow
PGUSER=afadmin
PGPASSWORD=your_db_password
PGSSL=false
